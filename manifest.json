{
  "manifest_version": 3,
  "name": "Streamer Web Tools",
  "short_name": "Streamer Tools",
  "version": "1.2.2",
  "description": "Live filtering, site rules, and right-click MHTML archiving in one Chromium extension.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "scripting",
    "userScripts",
    "downloads",
    "offscreen",
    "pageCapture",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Streamer Web Tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "rules/icons/inactive-16.png",
      "32": "rules/icons/inactive-32.png",
      "48": "rules/icons/inactive-48.png",
      "128": "rules/icons/inactive-128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "filter/core.js",
        "unicode_filter.js",
        "filter/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rules/shared.js",
        "rules/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "rules/icons/inactive-16.png",
    "32": "rules/icons/inactive-32.png",
    "48": "rules/icons/inactive-48.png",
    "128": "rules/icons/inactive-128.png"
  },
  "sidebar_action": {
    "default_icon": "filter/icons/icon32.png",
    "default_title": "Streamer Web Tools Settings",
    "default_panel": "options.html"
  }
}
